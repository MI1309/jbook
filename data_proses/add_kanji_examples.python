    "駅": [
        {"word": "駅", "reading": "えき", "meaning": "Stasiun"},
        {"word": "駅員", "reading": "えきいん", "meaning": "Petugas stasiun"},
        {"word": "駅前", "reading": "えきまえ", "meaning": "Depan stasiun"}
    ]
}

def update_examples():
    conn = sqlite3.connect(db_path)
    cursor = conn.cursor()
    
    print("Memulai update contoh kata (examples)...")
    updated_count = 0
    
    for char, examples in EXAMPLES_DATA.items():
        examples_json = json.dumps(examples, ensure_ascii=False)
        cursor.execute(
            "UPDATE content_kanji SET examples = ? WHERE character = ?",
            (examples_json, char)
        )
        if cursor.rowcount > 0:
            print(f"Updated examples for: {char}")
            updated_count += 1
            
    conn.commit()
    conn.close()
    print(f"\nSelesai! {updated_count} kanji telah dilengkapi dengan contoh kata.")

if __name__ == "__main__":
    update_examples()
