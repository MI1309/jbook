# ==============================================
# JBook Frontend (Next.js) Environment Variables Template
# ==============================================
# Copy this file to `.env.local` for development, or set via Vercel env vars for production.
# NEVER commit real .env files.
# ==============================================

# -------- PUBLIC (exposed to browser) --------
# Backend API root URL (include /api suffix)
# Local Django: http://localhost:8000/api
# Production PythonAnywhere: https://yourname.pythonanywhere.com/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Canonical app URL (used in sitemap, meta tags)
# Local dev: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -------- SERVER-SIDE ONLY (never exposed to browser) --------
# Vercel Blob token (for upload route)
# Get from Vercel Project Settings → Environment Variables
BLOB_READ_WRITE_TOKEN=

# -------- MAINTENANCE MODE (Vercel) --------
# Set to 'true' to activate maintenance mode (returns HTTP 503)
MAINTENANCE_MODE=false
# Secret bypass key (access via: https://yourdomain.com/?bypass=your-secret-token)
MAINTENANCE_BYPASS_TOKEN=jbook-admin-secret
