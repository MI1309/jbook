# ==============================================
# JBook Backend Environment Variables Template
# ==============================================
# Copy this file to `.env` and fill in your values.
# NEVER commit the real .env file.
# ==============================================

# -------- DJANGO CORE --------
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# "True" for local development, "False" for production
DEBUG=True

# Comma-separated list of allowed hostnames/domains
# Production: yourdomain.com,api.yourdomain.com
# Dev: localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# -------- CORS / CSRF --------
# Comma-separated list of frontend origins allowed to make cross-origin requests
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# CSRF trusted origins (include scheme://host)
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# URLs (used in emails, password reset links, etc.)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# -------- EMAIL (SMTP) --------
# Production: fill these; Dev mode default to console backend.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# -------- OAUTH / 3RD PARTY --------
# Google OAuth 2.0 Client ID (for Google Login with Google)
# Get from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=

# -------- JWT TOKEN LIFETIMES (optional) --------
# Access token lifetime in minutes (default: 15)
JWT_ACCESS_MINUTES=15

# Refresh token lifetime in days (default: 7)
JWT_REFRESH_DAYS=7

# Session cookie age in days (default: 7)
SESSION_DAYS=7

# -------- CACHE --------
# 'filebased' or 'locmem' (see docs)
CACHE_BACKEND=filebased
# Path to cache directory (for filebased cache only)
CACHE_DIR=

# -------- OPTIONAL: JWKS URL jika pakai external JWT issuer
JWK_URL=
