# ==============================================
# JBook Backend Environment Variables Template
# ==============================================
# Copy this file to `.env` and fill in your values.
# NEVER commit the real .env file.
# ==============================================

# -------- DJANGO CORE --------
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
# GOOGLE_CLIENT_ID=

# Production-safe default. Set DEBUG=True only for local development.
DEBUG=False

# Comma-separated list of allowed hostnames/domains
# Production: imronm.pythonanywhere.com
# Dev: localhost,127.0.0.1
ALLOWED_HOSTS=imronm.pythonanywhere.com

# -------- CORS / CSRF --------
# Comma-separated list of frontend origins allowed to make cross-origin requests
CORS_ALLOWED_ORIGINS=https://jbook-five.vercel.app

# CSRF trusted origins (include scheme://host)
CSRF_TRUSTED_ORIGINS=https://jbook-five.vercel.app

# URLs (used in emails, password reset links, etc.)
FRONTEND_URL=https://jbook-five.vercel.app
BACKEND_URL=https://imronm.pythonanywhere.com

# Leave blank only for a small/low-write SQLite deployment.
# Use the database URL provided by your production host for PostgreSQL.
DATABASE_URL=
DB_CONN_MAX_AGE=600

# Set False only if the hosting platform terminates HTTPS and causes redirect loops.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# -------- EMAIL (SMTP) --------
# Configure SMTP to enable password-reset emails. Without these, the API still starts,
# but password-reset emails are disabled.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# -------- OAUTH / 3RD PARTY --------
# Google OAuth 2.0 Client ID (Google sign-in is disabled if left blank in production)
# Get from Google Cloud Console.

# -------- JWT TOKEN LIFETIMES (optional) --------
# Access token lifetime in minutes (default: 15)
JWT_ACCESS_MINUTES=15

# Refresh token lifetime in days (default: 7)
JWT_REFRESH_DAYS=7

# Session cookie age in days (default: 7)
SESSION_DAYS=7

# -------- CACHE --------
# 'filebased' or 'locmem' (see docs)
CACHE_BACKEND=filebased
# Path to cache directory (for filebased cache only)
CACHE_DIR=

# -------- OPTIONAL: JWKS URL jika pakai external JWT issuer
JWK_URL=
